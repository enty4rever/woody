---
// Closed / Open view for products with doorImages. Without JS both images show side by side
// and the buttons are hidden.
import type { Product } from '../data/products';
import { site } from '../data/site';
import PlaceholderBadge from './PlaceholderBadge.astro';
import RenderingTag from './RenderingTag.astro';
import Render from './Render.astro';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { closed, open } = product.doorImages ?? {};
const labels = site.product.doorView;
---

{closed && open && (
  <section
    class="door-view"
    aria-labelledby="door-view-title"
    data-door-view
  >
    <header class="head">
      <p class="eyebrow">{labels.eyebrow}</p>
      <h2 id="door-view-title">{labels.title}</h2>
    </header>
    <figure class="media">
      <div class="toggle" role="group" aria-label={labels.label}>
        <button type="button" data-show="closed" aria-pressed="true">{labels.closed}</button>
        <button type="button" data-show="open" aria-pressed="false">{labels.open}</button>
      </div>
      <div class="stage">
        <div class="view is-active" data-view="closed">
          <Render file={closed.file} alt={closed.alt} sizes="(min-width: 1280px) 640px, (min-width: 900px) 55vw, 100vw" />
        </div>
        <div class="view" data-view="open">
          <Render file={open.file} alt={open.alt} sizes="(min-width: 1280px) 640px, (min-width: 900px) 55vw, 100vw" />
        </div>
        <PlaceholderBadge isPlaceholder={product.isPlaceholder} />
        <RenderingTag />
      </div>
      <figcaption>{labels.caption}</figcaption>
    </figure>
  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-door-view]').forEach((root) => {
    const views = root.querySelectorAll<HTMLElement>('[data-view]');
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-show]');

    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
        views.forEach((view) => view.classList.toggle('is-active', view.dataset.view === button.dataset.show));
      }),
    );
  });
</script>

<style>
  /* Mobile: heading, then buttons directly above the image, caption below.
     From 900px: buttons + image + caption in the left 55% column (same as the gallery),
     heading in the right column. */
  .door-view {
    display: grid;
    gap: var(--space-5);
  }

  .head {
    display: grid;
    gap: var(--space-2);
  }

  .media {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    min-width: 0;
  }

  .stage {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-border);
    overflow: hidden;
  }

  /* 1:1 white frame; the render is never cropped */
  .view {
    aspect-ratio: 1 / 1;
    background: var(--color-image-bg);
  }

  .view :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* With JS: one image at a time */
  :global(html.js) .stage {
    grid-template-columns: 1fr;
  }

  :global(html.js) .stage .view:not(.is-active) {
    display: none;
  }

  :global(html:not(.js)) .toggle {
    display: none;
  }

  .toggle {
    display: inline-flex;
    border: 1px solid var(--color-green);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .toggle button {
    min-width: 6rem;
    padding: var(--space-2) var(--space-4);
    border: 0;
    background: transparent;
    color: var(--color-muted);
    font: inherit;
    font-weight: 500;
    cursor: pointer;
  }

  .toggle button + button {
    border-left: 1px solid var(--color-green);
  }

  .toggle button[aria-pressed='true'] {
    background: var(--color-surface);
    color: var(--color-green);
    box-shadow: inset 0 -2px 0 var(--color-green);
  }

  .toggle button:focus-visible {
    outline-offset: -4px;
  }

  figcaption {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  @media (min-width: 900px) {
    .door-view {
      grid-template-columns: 55fr 45fr;
      gap: var(--space-8);
      align-items: start;
    }

    .media {
      grid-column: 1;
      grid-row: 1;
    }

    .head {
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>
