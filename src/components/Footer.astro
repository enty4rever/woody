---
const links = [
  { href: '/collection', label: 'Bộ sưu tập' },
  { href: '/our-story', label: 'Câu chuyện' },
  { href: '/fit-and-care', label: 'Đo & bảo quản' },
  { href: '/policies', label: 'Chính sách' },
  { href: '/contact', label: 'Liên hệ' },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <div class="brand">
      <a href="/" class="logo">Woody</a>
      <p class="note">Chỉ để xem trước, không bán hàng.</p>
      <!-- TODO: contact info (email / Zalo / Facebook) not provided yet -->
    </div>
    <nav aria-label="Điều hướng chân trang">
      <ul>
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="container">
    <p class="copy">© {year} Woody</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-8);
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    padding-block: var(--space-6) var(--space-5);
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .logo {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
  }

  .note,
  .copy {
    color: var(--color-text);
    font-size: var(--text-sm);
  }

  .note {
    margin-top: var(--space-1);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    list-style: none;
    padding: 0;
  }

  nav a {
    display: inline-block;
    padding-block: var(--space-1);
    color: var(--color-muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .copy {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }
  }
</style>
