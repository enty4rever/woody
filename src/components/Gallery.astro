---
// Product gallery: main image, prev/next, thumbnails, arrow keys, swipe on touch.
// Every image of every color is rendered on the server as <picture> (AVIF + WebP); the script
// only shows one slide and one thumbnail row at a time. Slides after the first load lazily,
// so hidden ones cost nothing until shown. "color-change" (sent by ColorSwatch) picks the set.
// Without JS only the first image and the counter show.
import type { Product } from '../data/products';
import { site } from '../data/site';
import PlaceholderBadge from './PlaceholderBadge.astro';
import RenderingTag from './RenderingTag.astro';
import Render from './Render.astro';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const first = product.colors[0];
const count = first?.images.length ?? 0;
const labels = site.product.gallery;
/** Gallery column: full width on mobile, ~55% of the 1200px container from 900px. */
const SIZES = '(min-width: 1280px) 640px, (min-width: 900px) 55vw, 100vw';
---

<section
  class="gallery"
  data-gallery
  data-product={product.slug}
  data-color={first?.id}
  aria-label={labels.label}
  aria-roledescription="carousel"
  tabindex="0"
>
  <div class="stage">
    {product.colors.map((color, c) =>
      color.images.map((image, i) => (
        <div class="slide" data-slide={i} data-color={color.id} hidden={c > 0 || i > 0}>
          <Render
            file={image.file}
            alt={image.alt}
            sizes={SIZES}
            loading={c === 0 && i === 0 ? 'eager' : 'lazy'}
            fetchpriority={c === 0 && i === 0 ? 'high' : undefined}
          />
        </div>
      )),
    )}
    <PlaceholderBadge isPlaceholder={product.isPlaceholder} />
    <RenderingTag counter={`1/${count}`} />
    <button type="button" class="nav prev" data-step="-1" aria-label={labels.prev} hidden={count < 2}>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" /></svg>
    </button>
    <button type="button" class="nav next" data-step="1" aria-label={labels.next} hidden={count < 2}>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" /></svg>
    </button>
  </div>
  {product.colors.map((color, c) => (
    <ul class="thumbs" data-thumbs={color.id} hidden={c > 0}>
      {color.images.map((image, i) => (
        <li>
          <button type="button" data-thumb={i} aria-label={`${labels.thumb} ${i + 1}`} aria-current={i === 0 ? 'true' : undefined}>
            <Render file={image.file} alt="" sizes="80px" widths={[160]} />
          </button>
        </li>
      ))}
    </ul>
  ))}
</section>

<script>
  /** Horizontal distance (px) a swipe must travel to change the image. */
  const SWIPE_MIN = 40;

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('.stage');
    const counter = root.querySelector<HTMLElement>('[data-counter]');
    const navButtons = root.querySelectorAll<HTMLButtonElement>('[data-step]');
    if (!stage) return;

    const slidesOf = (color: string) =>
      [...stage.querySelectorAll<HTMLElement>('[data-slide]')].filter((s) => s.dataset.color === color);
    let slides = slidesOf(root.dataset.color ?? '');
    let index = 0;

    const thumbsOf = (color: string) => root.querySelector<HTMLUListElement>(`[data-thumbs="${color}"]`);

    const show = (i: number) => {
      if (slides.length === 0) return;
      index = (i + slides.length) % slides.length;
      stage.querySelectorAll<HTMLElement>('[data-slide]').forEach((slide) => (slide.hidden = true));
      slides[index].hidden = false;
      if (counter) counter.textContent = `${index + 1}/${slides.length}`;
      thumbsOf(root.dataset.color ?? '')
        ?.querySelectorAll('button')
        .forEach((button, j) => {
          if (j === index) button.setAttribute('aria-current', 'true');
          else button.removeAttribute('aria-current');
        });
    };

    navButtons.forEach((button) =>
      button.addEventListener('click', () => show(index + Number(button.dataset.step))),
    );

    root.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-thumb]');
      if (button) show(Number(button.dataset.thumb));
    });

    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault();
        show(index + (event.key === 'ArrowRight' ? 1 : -1));
      }
    });

    // Swipe. touch-action: pan-y on the stage keeps vertical scroll native and hands
    // horizontal moves to us; pointercancel drops a gesture the browser took over.
    let start: { id: number; x: number; y: number } | null = null;
    stage.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse') return;
      start = { id: event.pointerId, x: event.clientX, y: event.clientY };
    });
    stage.addEventListener('pointerup', (event) => {
      if (!start || start.id !== event.pointerId) return;
      const dx = event.clientX - start.x;
      const dy = event.clientY - start.y;
      start = null;
      if (Math.abs(dx) >= SWIPE_MIN && Math.abs(dx) > Math.abs(dy)) show(index + (dx < 0 ? 1 : -1));
    });
    stage.addEventListener('pointercancel', () => (start = null));

    document.addEventListener('color-change', (event) => {
      const { product, color } = (event as CustomEvent<{ product: string; color: string }>).detail;
      const next = slidesOf(color);
      if (product !== root.dataset.product || next.length === 0) return;
      thumbsOf(root.dataset.color ?? '')?.setAttribute('hidden', '');
      thumbsOf(color)?.removeAttribute('hidden');
      root.dataset.color = color;
      slides = next;
      navButtons.forEach((button) => (button.hidden = slides.length < 2));
      show(0);
    });
  });
</script>

<style>
  .gallery {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
  }

  .gallery:focus-visible {
    outline-offset: 4px;
  }

  .stage {
    position: relative;
    aspect-ratio: 1 / 1;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-image-bg);
    overflow: hidden;
    touch-action: pan-y;
    user-select: none;
  }

  /* 1:1 white frame; the render is never cropped */
  .slide {
    position: absolute;
    inset: 0;
  }

  .slide[hidden] {
    display: none;
  }

  .stage :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    -webkit-user-drag: none;
  }

  .nav {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-green);
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-green);
    cursor: pointer;
    transform: translateY(-50%);
  }

  .nav:hover {
    border-color: var(--color-green-hover);
    color: var(--color-green-hover);
  }

  .nav[hidden] {
    display: none;
  }

  .prev {
    left: var(--space-2);
  }

  .next {
    right: var(--space-2);
  }

  .thumbs {
    display: flex;
    gap: var(--space-2);
    padding: 2px;
    margin: 0;
    list-style: none;
    overflow-x: auto;
  }

  .thumbs button {
    display: block;
    width: 64px;
    padding: 0;
    border: 2px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-image-bg);
    overflow: hidden;
    cursor: pointer;
  }

  .thumbs button[aria-current='true'] {
    border-color: var(--color-green);
  }

  .thumbs[hidden] {
    display: none;
  }

  .thumbs :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: contain;
  }

  /* Without JS the controls do nothing, so hide them */
  :global(html:not(.js)) .nav,
  :global(html:not(.js)) .thumbs {
    display: none;
  }

  @media (min-width: 900px) {
    .thumbs button {
      width: 80px;
    }
  }
</style>
