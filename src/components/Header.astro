---
import { site } from '../data/site';

interface Props {
  /** Show the Quick help icon (below 720px). It opens the dialog in QuickHelp.astro. */
  quickHelp?: boolean;
}

const { quickHelp = false } = Astro.props;
const links = site.nav.filter((link) => !link.footerOnly);

const current = Astro.url.pathname.replace(/\/$/, '');
---

<header class="site-header">
  <div class="container inner">
    <!-- TODO: replace text logo with SVG when available -->
    <a href="/" class="logo">{site.brand}</a>
    {quickHelp && (
      <button
        type="button"
        class="btn btn-outline qh-icon"
        aria-label={site.quickHelp.open}
        aria-haspopup="dialog"
        data-quickhelp-open
      >
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 5.5A1.5 1.5 0 0 1 5.5 4h13A1.5 1.5 0 0 1 20 5.5v9a1.5 1.5 0 0 1-1.5 1.5H10l-4 3.5V16H5.5A1.5 1.5 0 0 1 4 14.5z" />
          <path d="M10 8.25a2 2 0 1 1 2.75 1.85c-.45.2-.75.62-.75 1.1v.3" />
          <circle cx="12" cy="13.6" r="0.5" fill="currentColor" stroke="none" />
        </svg>
      </button>
    )}
    <button
      type="button"
      class="btn btn-outline menu-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      {site.header.menuLabel}
    </button>
    <nav id="site-nav" aria-label={site.header.navLabel}>
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={current === link.href ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  // Mobile menu (< 720px). Without JS the links simply stay visible as a vertical list.
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = header?.querySelector<HTMLElement>('#site-nav');

  if (header && toggle && nav) {
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      header.classList.toggle('is-open', open);
    };

    toggle.addEventListener('click', () => setOpen(!isOpen()));

    nav.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
  }

  /* Mobile: logo + Menu button on one row, links stack below when open */
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-4);
  }

  .logo {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
  }

  .menu-toggle {
    display: none;
    padding: var(--space-2) var(--space-4);
    background: transparent;
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
  }

  :global(html.js) .menu-toggle {
    display: inline-block;
  }

  /* Quick help icon (below 720px, JS only): in the flow, so it never covers page content */
  .qh-icon {
    display: none;
    width: 44px;
    height: 44px;
    margin-left: auto;
    padding: 0;
    background: transparent;
    cursor: pointer;
    align-items: center;
    justify-content: center;
  }

  :global(html.js) .qh-icon {
    display: inline-flex;
  }

  nav {
    flex-basis: 100%;
  }

  :global(html.js) .site-header:not(.is-open) nav {
    display: none;
  }

  ul {
    display: grid;
    list-style: none;
    padding: 0;
  }

  nav a {
    display: block;
    padding-block: var(--space-3);
    color: var(--color-text);
    font-weight: 500;
    text-decoration: none;
  }

  nav li + li {
    border-top: 1px solid var(--color-border);
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--color-accent);
    text-decoration: underline;
  }

  /* 720px+: horizontal nav, no Menu button */
  @media (min-width: 720px) {
    .inner {
      flex-wrap: nowrap;
      padding-block: var(--space-5);
    }

    :global(html.js) .menu-toggle,
    :global(html.js) .qh-icon {
      display: none;
    }

    nav,
    :global(html.js) .site-header:not(.is-open) nav {
      display: block;
      flex-basis: auto;
    }

    ul {
      display: flex;
      gap: var(--space-6);
      white-space: nowrap;
    }

    nav li + li {
      border-top: 0;
    }

    nav a {
      display: inline-block;
      padding-block: var(--space-2);
    }
  }
</style>
