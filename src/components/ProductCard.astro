---
// Product summary card. Image and name link to the product page; the image link is
// hidden from Tab and screen readers so the name and button are the only announced links.
import type { Product } from '../data/products';
import { site } from '../data/site';
import { formatUsd } from '../lib/format';
import { formatDimensions } from '../lib/units';
import PlaceholderBadge from './PlaceholderBadge.astro';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const href = `/products/${product.slug}`;
const image = product.colors[0]?.images[0];
---

<article class="product-card">
  <a href={href} class="media" tabindex="-1" aria-hidden="true">
    {image && <img src={image.src} alt={image.alt} width="800" height="1000" loading="lazy" />}
    <PlaceholderBadge isPlaceholder={product.isPlaceholder} />
  </a>
  <div class="body">
    <p class="eyebrow">{site.home.productTypeLabel[product.type]}</p>
    <h3 class="name"><a href={href}>{product.name}</a></h3>
    <p class="line">{product.shortLine}</p>
    <p class="price">{formatUsd(product.priceUsd)}</p>
    <p class="size">{formatDimensions(product.dimensionsCm)}</p>
    <a href={href} class="btn btn-outline" aria-label={`${site.home.productCta}: ${product.name}`}>
      {site.home.productCta}
    </a>
  </div>
</article>

<style>
  .product-card {
    display: grid;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color 0.15s;
  }

  .product-card:hover,
  .product-card:focus-within {
    border-color: var(--color-green);
  }

  .media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    background: var(--color-bg);
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .body {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    padding: var(--space-5);
  }

  .name a {
    color: var(--color-text);
    text-decoration: none;
  }

  .name a:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  .line {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .price {
    color: var(--color-accent);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .size {
    margin-top: calc(-1 * var(--space-1));
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .btn {
    margin-top: var(--space-2);
  }
</style>
