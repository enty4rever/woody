---
// One product render as <picture>: AVIF + WebP at 480 / 960 / 1440 px (never above the source).
// Sizing and framing (1:1 white frame, object-fit: contain) are up to the parent.
import { Picture } from 'astro:assets';
import { productAsset, imageWidths } from '../lib/images';

interface Props {
  /** File name in src/assets/products/, without ".webp". */
  file: string;
  alt: string;
  /** How wide the image shows, e.g. "(min-width: 900px) 55vw, 100vw". */
  sizes: string;
  /** Override the default widths (e.g. small thumbnails). */
  widths?: number[];
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
}

const { file, alt, sizes, widths, loading = 'lazy', fetchpriority, class: className } = Astro.props;
const src = productAsset(file);
---

<Picture
  src={src}
  alt={alt}
  widths={imageWidths(src.width, widths)}
  sizes={sizes}
  formats={['avif', 'webp']}
  fallbackFormat="webp"
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
  class={className}
/>
