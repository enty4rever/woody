---
// Small "Rendering" label in the bottom-left corner of a product image.
// With `counter`, it reads "Rendering · 1/4" and the gallery script updates [data-counter].
// The parent element must have position: relative.
import { site } from '../data/site';

interface Props {
  counter?: string;
}

const { counter } = Astro.props;
---

<span class="rendering-tag" aria-live={counter ? 'polite' : undefined}>
  {site.rendering}{counter && <> · <span data-counter>{counter}</span></>}
</span>

<style>
  .rendering-tag {
    position: absolute;
    left: var(--space-2);
    bottom: var(--space-2);
    z-index: 2;
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: var(--text-xs);
    font-weight: 500;
    line-height: 1.2;
    pointer-events: none;
  }
</style>
