---
// Self-hosted fonts (no third-party requests), only the weights in use. The weight files carry
// unicode-range per subset, so the browser downloads only the subsets a page actually uses.
import '@fontsource/lora/500.css';
import '@fontsource/lora/600.css';
import '@fontsource/be-vietnam-pro/400.css';
import '@fontsource/be-vietnam-pro/500.css';
import '@fontsource/be-vietnam-pro/600.css';
import '../styles/global.css';
// Same files the CSS above references (Vite gives both the same hashed URL): preloaded because
// the first screen needs them (headings Lora 500, body Be Vietnam Pro 400).
import loraUrl from '@fontsource/lora/files/lora-latin-500-normal.woff2?url';
import beVietnamUrl from '@fontsource/be-vietnam-pro/files/be-vietnam-pro-latin-400-normal.woff2?url';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuickHelp from '../components/QuickHelp.astro';
import { site } from '../data/site';

interface Props {
  /** Page name. The brand is appended: "<title> | <brand>". */
  title: string;
  description?: string;
  /** Quick help button and dialog. Off on 404. */
  quickHelp?: boolean;
}

const { title, description = site.home.meta.description, quickHelp = true } = Astro.props;
const fullTitle = `${title} | ${site.brand}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Mark JS before any CSS applies so the mobile menu starts collapsed (no layout shift) -->
    <script is:inline>document.documentElement.classList.add('js')</script>
    <!-- Saved in / cm choice (SpecTable), set before paint so cm users never see inches flash.
         Key "unit" must match SpecTable.astro. -->
    <script is:inline>
      (function () {
        var unit = 'in';
        try { if (localStorage.getItem('unit') === 'cm') unit = 'cm'; } catch (e) {}
        document.documentElement.dataset.unit = unit;
      })();
    </script>
    <link rel="preload" href={loraUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={beVietnamUrl} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    {site.seo.noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={site.seo.ogType} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{site.skipLink}</a>
    <AnnouncementBar />
    <Header quickHelp={quickHelp} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {quickHelp && <QuickHelp />}
  </body>
</html>
