---
// Self-hosted fonts (no third-party requests): latin + latin-ext, only the weights in use.
import '@fontsource/lora/latin-500.css';
import '@fontsource/lora/latin-ext-500.css';
import '@fontsource/lora/latin-600.css';
import '@fontsource/lora/latin-ext-600.css';
import '@fontsource/be-vietnam-pro/latin-400.css';
import '@fontsource/be-vietnam-pro/latin-ext-400.css';
import '@fontsource/be-vietnam-pro/latin-500.css';
import '@fontsource/be-vietnam-pro/latin-ext-500.css';
import '@fontsource/be-vietnam-pro/latin-600.css';
import '@fontsource/be-vietnam-pro/latin-ext-600.css';
import '../styles/global.css';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuickHelp from '../components/QuickHelp.astro';
import { site } from '../data/site';

interface Props {
  /** Page name. The brand is appended: "<title> | <brand>". */
  title: string;
  description?: string;
  /** Quick help button and dialog. Off on 404. */
  quickHelp?: boolean;
}

const { title, description = site.home.meta.description, quickHelp = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Mark JS before any CSS applies so the mobile menu starts collapsed (no layout shift) -->
    <script is:inline>document.documentElement.classList.add('js')</script>
    <!-- Saved in / cm choice (SpecTable), set before paint so cm users never see inches flash.
         Key "unit" must match SpecTable.astro. -->
    <script is:inline>
      (function () {
        var unit = 'in';
        try { if (localStorage.getItem('unit') === 'cm') unit = 'cm'; } catch (e) {}
        document.documentElement.dataset.unit = unit;
      })();
    </script>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{`${title} | ${site.brand}`}</title>
  </head>
  <body>
    <AnnouncementBar />
    <Header quickHelp={quickHelp} />
    <main>
      <slot />
    </main>
    <Footer />
    {quickHelp && <QuickHelp />}
  </body>
</html>
