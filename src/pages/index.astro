---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import PlaceholderBadge from '../components/PlaceholderBadge.astro';
import RenderingTag from '../components/RenderingTag.astro';
import Render from '../components/Render.astro';
import { products } from '../data/products';
import { site } from '../data/site';

const { meta, hero, steps, story } = site.home;
const section = site.home.products;
const stepNumber = (i: number) => String(i + 1).padStart(2, '0');
---

<Base title={meta.title} description={meta.description}>
  <section class="container hero">
    <div class="hero-text">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1>{hero.title}</h1>
      <p class="intro">{hero.intro}</p>
      <div class="actions">
        <a href={hero.primary.href} class="btn btn-primary">{hero.primary.label}</a>
        <a href={hero.secondary.href} class="text-link">{hero.secondary.label}</a>
      </div>
    </div>
    <div class="hero-media">
      <Render
        file={hero.image.file}
        alt={hero.image.alt}
        sizes="(min-width: 1280px) 560px, (min-width: 900px) 50vw, 100vw"
        loading="eager"
        fetchpriority="high"
      />
      <PlaceholderBadge isPlaceholder={site.isPlaceholder} />
      <RenderingTag />
    </div>
  </section>

  <section class="container block" aria-labelledby="products-title">
    <header class="block-head">
      <p class="eyebrow">{section.eyebrow}</p>
      <h2 id="products-title">{section.title}</h2>
    </header>
    <div class="product-grid">
      {products.map((product) => <ProductCard product={product} />)}
    </div>
  </section>

  <section class="container block" aria-labelledby="steps-title">
    <header class="block-head">
      <p class="eyebrow">{steps.eyebrow}</p>
      <h2 id="steps-title">{steps.title}</h2>
    </header>
    <ol class="steps">
      {steps.items.map((step, i) => (
        <li>
          <span class="step-number" aria-hidden="true">{stepNumber(i)}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="container block">
    <figure class="story">
      <blockquote>
        <p>{story.quote}</p>
      </blockquote>
      <figcaption>{story.cite}</figcaption>
      <a href={story.link.href} class="text-link">{story.link.label} <span aria-hidden="true">→</span></a>
    </figure>
  </section>
</Base>

<style>
  /* Hero: text on top, image below; side by side from 900px */
  .hero {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-6) var(--space-7);
  }

  .hero-text {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .intro {
    max-width: 36rem;
    color: var(--color-muted);
    font-size: var(--text-lg);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-2);
  }

  .text-link {
    font-weight: 500;
    text-decoration: underline;
  }

  .hero-media {
    position: relative;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .hero-media {
    background: var(--color-image-bg);
  }

  .hero-media :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Shared section spacing */
  .block {
    padding-block: var(--space-7);
  }

  .block-head {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .product-grid {
    display: grid;
    gap: var(--space-5);
  }

  /* Steps: green numbers and thin green rule = identity, no green fill */
  .steps {
    display: grid;
    gap: var(--space-6);
    list-style: none;
    padding: 0;
  }

  .steps li {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 2px solid var(--color-green);
  }

  .step-number {
    color: var(--color-green);
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 600;
    line-height: 1;
  }

  .steps p {
    color: var(--color-muted);
  }

  /* Story teaser */
  .story {
    display: grid;
    gap: var(--space-4);
    justify-items: center;
    max-width: 44rem;
    margin-inline: auto;
    padding-block: var(--space-7);
    border-block: 1px solid var(--color-border);
    text-align: center;
  }

  .story blockquote {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-style: italic;
    line-height: 1.4;
  }

  .story figcaption {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  @media (min-width: 640px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .block {
      padding-block: var(--space-8);
    }

    .steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: var(--space-8);
      padding-block: var(--space-8);
    }
  }
</style>
