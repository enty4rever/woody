---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { site } from '../data/site';

const copy = site.ourStory;
---

<Base title={copy.meta.title} description={copy.meta.description}>
  <div class="container">
    <Breadcrumb current={copy.meta.title} />

    <article class="story">
      <h1>{copy.title}</h1>
      {copy.paragraphs.map((text) => <p>{text}</p>)}
      <figure class="quote">
        <blockquote>
          <p>{copy.quote}</p>
        </blockquote>
        <figcaption>{copy.cite}</figcaption>
      </figure>
    </article>
  </div>
</Base>

<style>
  .story {
    display: grid;
    gap: var(--space-4);
    max-width: 40rem;
    padding-block: var(--space-4) var(--space-7);
  }

  .story h1 {
    margin-bottom: var(--space-2);
  }

  .story > p {
    font-size: var(--text-lg);
  }

  /* Thin green rule = identity accent, no fill */
  .quote {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-5);
    padding-left: var(--space-5);
    border-left: 2px solid var(--color-green);
  }

  .quote blockquote {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-style: italic;
    line-height: 1.4;
  }

  .quote figcaption {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
</style>
