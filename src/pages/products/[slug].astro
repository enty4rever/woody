---
// Product page (Phase 4a top half, Phase 4b specs to cross-sell). Every fact comes from products.ts,
// every label from site.ts.
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Gallery from '../../components/Gallery.astro';
import ColorSwatch from '../../components/ColorSwatch.astro';
import StickyInfo from '../../components/StickyInfo.astro';
import DoorToggle from '../../components/DoorToggle.astro';
import FeatureList from '../../components/FeatureList.astro';
import SpecTable from '../../components/SpecTable.astro';
import FitChecker from '../../components/FitChecker.astro';
import Care from '../../components/Care.astro';
import Faq from '../../components/Faq.astro';
import CrossSell from '../../components/CrossSell.astro';
import { products, type Product } from '../../data/products';
import { site } from '../../data/site';
import { formatUsd, formatSize } from '../../lib/format';
import { formatPounds, formatKg } from '../../lib/units';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const copy = site.product;
const facts = copy.keyFacts;
const helpLinks = site.support.productLinks;

// Sizes and weight come as an in / cm pair; html[data-unit] shows one (same as SpecTable).
type Fact = string | { in: string; cm: string };
const keyFacts: Fact[] = [
  { in: formatSize(product, 'in'), cm: formatSize(product, 'cm') },
  `${facts.wood}: ${product.woodType}`,
  facts.setup[product.setup],
  product.colors.length === 1 ? `${facts.color}: ${product.colors[0].name}` : facts.colors(product.colors.length),
  { in: `${facts.weight}: ${formatPounds(product.weightKg)}`, cm: `${facts.weight}: ${formatKg(product.weightKg)}` },
  ...(product.antiTipKit ? [facts.antiTip(product.antiTipKitType)] : []),
];
---

<Base title={product.name} description={product.shortLine}>
  <div class="container">
    <Breadcrumb items={[site.breadcrumb.collection]} current={product.name} />

    <div class="product-top">
      <Gallery product={product} />

      <StickyInfo>
        <div class="info">
          <p class="eyebrow">{site.home.productTypeLabel[product.type]}</p>
          <h1>{product.name}</h1>
          <p class="line">{product.shortLine}</p>
          <p class="price">
            <span class="amount">{formatUsd(product.priceUsd)}</span>
            <span class="price-note">{copy.priceNote}</span>
          </p>
          <ColorSwatch product={product} />
          <ul class="facts" aria-label={facts.label}>
            {keyFacts.map((fact) => (
              <li>
                {typeof fact === 'string' ? fact : (
                  <>
                    <span data-u="in">{fact.in}</span>
                    <span data-u="cm">{fact.cm}</span>
                  </>
                )}
              </li>
            ))}
          </ul>
          <a href={copy.cta.href} class="btn btn-primary cta">{copy.cta.label}</a>
        </div>
      </StickyInfo>
    </div>

    {product.doorImages && (
      <section class="block">
        <DoorToggle product={product} />
      </section>
    )}

    <div class="block">
      <FeatureList features={product.features} eyebrow={copy.features.eyebrow} title={copy.features.title} />
    </div>

    <div class="block">
      <SpecTable product={product} />
      <ul class="help-links">
        <li><a href={helpLinks.assembly.href}>{helpLinks.assembly.label}</a></li>
        {product.type === 'cabinet' && <li><a href={helpLinks.anchor.href}>{helpLinks.anchor.label}</a></li>}
      </ul>
    </div>

    <div class="block">
      <FitChecker product={product} />
    </div>

    <div class="block">
      <Care items={product.care} eyebrow={copy.care.eyebrow} title={copy.care.title} />
    </div>

    <div class="block">
      <Faq items={product.faq} eyebrow={copy.faq.eyebrow} title={copy.faq.title} />
    </div>

    <div class="block">
      <CrossSell product={product} />
    </div>
  </div>
</Base>

<style>
  /* Mobile: gallery on top, info below. From 900px: gallery ~55% left, info right. */
  .product-top {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }

  .info {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .info h1 {
    font-size: var(--text-2xl);
  }

  .line {
    color: var(--color-muted);
    font-size: var(--text-lg);
  }

  .price {
    display: grid;
    gap: var(--space-1);
  }

  .amount {
    color: var(--color-accent);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.2;
  }

  .price-note {
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .facts {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4) 0 0;
    border-top: 1px solid var(--color-border);
    list-style: none;
    font-size: var(--text-sm);
    justify-self: stretch;
  }

  /* Green dot = identity icon */
  .facts li {
    position: relative;
    padding-left: var(--space-5);
  }

  .facts li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-green);
  }

  .cta {
    justify-self: stretch;
    text-align: center;
  }

  .block {
    padding-block: var(--space-7);
  }

  .help-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-4);
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .help-links a {
    display: inline-block;
    padding-block: var(--space-2);
  }

  @media (min-width: 640px) {
    .cta {
      justify-self: start;
    }
  }

  @media (min-width: 768px) {
    .block {
      padding-block: var(--space-8);
    }
  }

  @media (min-width: 900px) {
    .product-top {
      grid-template-columns: 55fr 45fr;
      gap: var(--space-8);
    }
  }
</style>
