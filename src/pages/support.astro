---
// Support: assembly (guide not ready yet), anchoring the cabinet, contact. Email only plus a demo phone line.
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { products } from '../data/products';
import { site } from '../data/site';

const copy = site.support;
const contact = copy.contactSupport;
const cabinet = products.find((p) => p.type === 'cabinet');
const mailto = `mailto:${site.contact.email}?subject=${encodeURIComponent(contact.subject)}`;
---

<Base title={copy.meta.title} description={copy.meta.description}>
  <div class="container">
    <Breadcrumb current={copy.meta.title} />

    <article class="support">
      <header class="head">
        <h1>{copy.title}</h1>
        <p class="intro">{copy.intro}</p>
      </header>

      <section id={copy.assembly.id} aria-labelledby={`${copy.assembly.id}-title`}>
        <h2 id={`${copy.assembly.id}-title`}>{copy.assembly.title}</h2>
        <p>{copy.assembly.text}</p>
      </section>

      {cabinet && (
        <section id={copy.anchor.id} aria-labelledby={`${copy.anchor.id}-title`}>
          <p class="eyebrow">{cabinet.name}</p>
          <h2 id={`${copy.anchor.id}-title`}>{copy.anchor.title}</h2>
          {copy.anchor.text.map((text) => <p>{text}</p>)}
          {cabinet.antiTipKit && <p class="included">{site.product.keyFacts.antiTip}</p>}
        </section>
      )}

      <section id={contact.id} aria-labelledby={`${contact.id}-title`}>
        <h2 id={`${contact.id}-title`}>{contact.title}</h2>
        <dl class="lines">
          <div>
            <dt>{contact.emailLabel}</dt>
            <dd><a href={mailto}>{site.contact.email}</a></dd>
          </div>
          <div>
            <dt>{contact.phoneLabel}</dt>
            <dd>
              <a href={contact.phoneHref}>{contact.phone}</a>
              <span class="note">{contact.phoneNote}</span>
            </dd>
          </div>
        </dl>
        <p class="note">{contact.hours}</p>
        <!-- TODO: real contact email (site.contact.email) -->
      </section>
    </article>
  </div>
</Base>

<style>
  .support {
    display: grid;
    gap: var(--space-6);
    max-width: 44rem;
    padding-block: var(--space-4) var(--space-7);
  }

  .head {
    display: grid;
    gap: var(--space-3);
  }

  .intro {
    color: var(--color-muted);
    font-size: var(--text-lg);
  }

  section {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    scroll-margin-top: var(--space-5);
  }

  h2 {
    font-size: var(--text-xl);
  }

  /* Green dot = identity icon (same as the product key facts) */
  .included {
    position: relative;
    padding-left: var(--space-5);
    font-weight: 500;
  }

  .included::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-green);
  }

  .lines {
    display: grid;
    gap: var(--space-4);
  }

  dt {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  dd {
    display: grid;
    margin: 0;
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .note {
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 400;
  }
</style>
